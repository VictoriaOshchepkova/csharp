@model FinancialManager.Models.Budget

@{
    ViewData["Title"] = "Детали бюджета";
}

<h1>Детали бюджета</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BudgetId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BudgetId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayName("Email пользователя")
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayName("Категория")
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlannedAmount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PlannedAmount)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EndDate)
        </dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-id="@Model?.BudgetId" class="btn btn-primary">Редактировать</a>
    <a asp-action="Index" class="btn btn-light">Назад</a>
</div>
