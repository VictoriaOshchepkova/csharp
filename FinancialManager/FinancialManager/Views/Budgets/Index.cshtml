@model IEnumerable<FinancialManager.Models.Budget>

@{
    ViewData["Title"] = "Список бюджетов";
}

<h1>Список бюджетов</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mt-3">Добавить бюджет</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Email пользователя")
            </th>
            <th>
                @Html.DisplayName("Категория")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlannedAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.User.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PlannedAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.BudgetId" class="btn btn-outline-primary">Редактировать</a>
                    <a asp-action="Details" asp-route-id="@item.BudgetId" class="btn btn-outline-primary">Детали</a> 
                    <a asp-action="Delete" asp-route-id="@item.BudgetId" class="btn btn-outline-primary">Удалить</a>
            </td>
        </tr>
}
    </tbody>
</table>
