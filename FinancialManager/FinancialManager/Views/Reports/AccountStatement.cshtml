@model FinancialManager.Models.ViewModels.AccountStatementViewModel

@{
    ViewData["Title"] = "Ведомость по счетам";
}

<link rel="stylesheet" href="~/css/account-statement.css" />

<div class="container mt-4">
    <h1>Ведомость по счетам</h1>

    <div class="card mt-4 mb-4">
        <div class="card-header">
            <h5 class="mb-0">Параметры отчета</h5>
        </div>
        <div class="card-body">
            <form asp-action="AccountStatement" method="post" id="reportForm">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="UserId" class="control-label"></label>
                            <select asp-for="UserId" asp-items="Model.Users" class="form-control">
                                <option value="">Выберите пользователя</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="StartDate" class="control-label"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="EndDate" class="control-label"></label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">
                        Сформировать отчет
                    </button>
                    <button type="reset" class="btn btn-light">Сбросить</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Accounts != null && Model.Accounts.Any())
    {
        <div class="card">
            <div class="card-header bg-light text-secondary-emphasis">
                <h5 class="mb-0">
                    Результаты отчета
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <span class="float-end">Пользователь: @Model.Email</span>
                    }
                </h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped">
                        <thead class="table-secondary">
                            <tr>
                                <th>Название счета</th>
                                <th class="text-end">Начальный баланс</th>
                                <th class="text-end">Общий приход</th>
                                <th class="text-end">Общий расход</th>
                                <th class="text-end">Конечный баланс</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model.Accounts)
                            {
                                <tr>
                                    <td>@account.AccountName</td>
                                    <td class="text-end">@account.InitialBalance.ToString("N2") ₽</td>
                                    <td class="text-end text-success">+@account.TotalIncome.ToString("N2") ₽</td>
                                    <td class="text-end text-danger">-@account.TotalExpense.ToString("N2") ₽</td>
                                    <td class="text-end fw-bold">@account.FinalBalance.ToString("N2") ₽</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <th class="text-end">ИТОГО:</th>
                                <th class="text-end">@Model.TotalInitialBalance.ToString("N2") ₽</th>
                                <th class="text-end text-success">+@Model.TotalIncome.ToString("N2") ₽</th>
                                <th class="text-end text-danger">-@Model.TotalExpense.ToString("N2") ₽</th>
                                <th class="text-end fw-bold">@Model.TotalFinalBalance.ToString("N2") ₽</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.Accounts != null && !Model.Accounts.Any())
    {
        <div class="alert alert-warning mt-3">
            <i class="fas fa-exclamation-triangle"></i> У выбранного пользователя нет счетов или операций за указанный период.
        </div>
    }
</div>
