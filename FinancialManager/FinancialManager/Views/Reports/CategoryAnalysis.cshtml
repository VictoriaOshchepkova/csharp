@model FinancialManager.Models.ViewModels.CategoryAnalysisViewModel

@{
    ViewData["Title"] = "Анализ доходов и расходов по категориям";
}

<div class="container mt-4">
    <h1>Анализ доходов и расходов по категориям</h1>

    <div class="card mt-4 mb-4">
        <div class="card-header">
            <h5 class="mb-0">Параметры анализа</h5>
        </div>
        <div class="card-body">
            <form asp-action="CategoryAnalysis" method="post" id="analysisForm">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="UserId" class="control-label"></label>
                            <select asp-for="UserId" asp-items="Model.Users" class="form-control">
                                <option value="">Выберите пользователя</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="StartDate" class="control-label"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="EndDate" class="control-label"></label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">
                        Сформировать анализ
                    </button>
                    <button type="reset" class="btn btn-light">Сбросить</button>
                </div>
            </form>
        </div>
    </div>


    @if (Model.Categories != null && Model.Categories.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    Результаты анализа
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <span class="float-end">Пользователь: @Model.Email</span>
                    }
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Категория</th>
                                <th>Тип категории</th>
                                <th class="text-end">Количество операций</th>
                                <th class="text-end">Общая сумма</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td>@category.CategoryName</td>
                                    <td>@category.CategoryType</td>
                                    <td class="text-end">@category.TransactionCount</td>
                                    <td class="text-end fw-bold @(category.CategoryType == "Доход" || category.CategoryType == "Перевод (пополнение)" ? "text-success" : "text-danger")">
                                        @if (category.CategoryType == "Расход" || category.CategoryType == "Перевод (списание)")
                                        {
                                            <span>-</span>
                                        }
                                        else if (category.CategoryType == "Доход" || category.CategoryType == "Перевод (пополнение)")
                                        {
                                            <span>+</span>
                                        }
                                        @Math.Abs(category.TotalAmount).ToString("N2") ₽
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="3" class="text-end">ИТОГО:</th>
                                <th class="text-end fw-bold">
                                    @if (Model.TotalAmount >= 0)
                                    {
                                        <span class="text-success">+ @Model.TotalAmount.ToString("N2") ₽</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@Model.TotalAmount.ToString("N2") ₽</span>
                                    }
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.Categories != null && !Model.Categories.Any())
    {
        <div class="alert alert-warning mt-3">
            <i class="fas fa-exclamation-triangle"></i>
            Пользователь не совершил ни одной операции в данный период. Попробуйте изменить параметры фильтрации.
        </div>
    }
</div>