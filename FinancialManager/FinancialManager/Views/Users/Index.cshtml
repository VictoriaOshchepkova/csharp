@model IEnumerable<FinancialManager.Models.User>

@{
    ViewData["Title"] = "Список пользователей";
}

<h1>Список пользователей</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mt-3">Добавить пользователя</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Patronymic)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Patronymic)
            </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-outline-primary">Редактировать</a>
                    <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-outline-primary">Детали</a>
                    <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-outline-primary">Удалить</a>
            </td>
        </tr>
}
    </tbody>
</table>
