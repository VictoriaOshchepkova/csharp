@{
    ViewData["Title"] = "Главная - Финансовый менеджер";
}

<link rel="stylesheet" href="~/css/home.css" /> 

<body>
    <div class="container">
        <h1 class="page-title">Финансовый менеджер</h1>

        <div class="cards-grid">
            <div class="card card-users">
                <div class="card-header">
                    <span class="icon"><i class="fa-solid fa-users"></i></span> Пользователи
                </div>
                <div class="card-body">
                    <p class="card-text">Добавление, редактирование и удаление пользователей системы</p>
                </div>
                <div class="card-footer">
                    <a asp-controller="Users" asp-action="Index" class="btn btn-primary">
                        <span class="icon"><i class="fa-solid fa-list"></i></span>Список пользователей
                    </a>
                    <div class="btn-group">
                        <a asp-controller="Users" asp-action="Create" class="btn btn-secondary">
                            <span class="icon"><i class="fa-solid fa-plus"></i></span>Добавить пользователя
                        </a>
                    </div>
                </div>
            </div>

            <div class="card card-accounts">
                <div class="card-header">
                    <span class="icon"><i class="fa-solid fa-credit-card"></i></span> Счета
                </div>
                <div class="card-body">
                    <p class="card-text">Банковские счета, кредитные карты, наличные</p>
                </div>
                <div class="card-footer">
                    <a asp-controller="Accounts" asp-action="Index" class="btn btn-primary">
                        <span class="icon"><i class="fa-solid fa-list"></i></span>Список счетов
                    </a>
                    <div class="btn-group">
                        <a asp-controller="Accounts" asp-action="Create" class="btn btn-secondary">
                            <span class="icon"><i class="fa-solid fa-plus"></i></span>Добавить счет
                        </a>
                    </div>
                </div>
            </div>

            <div class="card card-categories">
                <div class="card-header">
                    <span class="icon"><i class="fa-solid fa-tags"></i></span> Категории
                </div>
                <div class="card-body">
                    <p class="card-text">Доходы, расходы, переводы между счетами</p>
                </div>
                <div class="card-footer">
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-primary">
                        <span class="icon"><i class="fa-solid fa-list"></i></span>Список категорий
                    </a>
                    <div class="btn-group">
                        <a asp-controller="Categories" asp-action="Create" class="btn btn-secondary">
                            <span class="icon"><i class="fa-solid fa-plus"></i></span>Добавить категорию
                        </a>
                    </div>
                </div>
            </div>

            <div class="card card-transactions">
                <div class="card-header">
                    <span class="icon"><i class="fa-solid fa-exchange-alt"></i></span> Транзакции
                </div>
                <div class="card-body">
                    <p class="card-text">Учет всех доходов и расходов</p>
                </div>
                <div class="card-footer">
                    <a asp-controller="Transactions" asp-action="Index" class="btn btn-primary">
                        <span class="icon"><i class="fa-solid fa-list"></i></span>Список транзакций
                    </a>
                    <div class="btn-group">
                        <a asp-controller="Transactions" asp-action="Create" class="btn btn-secondary">
                            <span class="icon"><i class="fa-solid fa-plus"></i></span>Добавить операцию
                        </a>
                    </div>
                </div>
            </div>

            <div class="card card-budgets">
                <div class="card-header">
                    <span class="icon"><i class="fa-solid fa-chart-pie"></i></span> Бюджеты
                </div>
                <div class="card-body">
                    <p class="card-text">Контроль расходов по категориям</p>
                </div>
                <div class="card-footer">
                    <a asp-controller="Budgets" asp-action="Index" class="btn btn-primary">
                        <span class="icon"><i class="fa-solid fa-list"></i></span>Список бюджетов
                    </a>
                    <div class="btn-group">
                        <a asp-controller="Budgets" asp-action="Create" class="btn btn-secondary">
                            <span class="icon"><i class="fa-solid fa-plus"></i></span>Добавить бюджет
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="reports">
            <div class="reports-header">
                <span class="icon"><i class="fa-solid fa-book"></i></span> Отчеты
            </div>
            <div class="reports-grid">
                <a asp-controller="Reports" asp-action="AccountStatement" class="btn btn-outline btn-outline-primary">
                    Ведомость по счетам
                </a>
                <a asp-controller="Reports" asp-action="TransactionHistory" class="btn btn-outline btn-outline-primary">
                    История операций
                </a>
                <a asp-controller="Reports" asp-action="CategoryAnalysis" class="btn btn-outline btn-outline-primary">
                    Анализ доходов и расходов
                </a>
            </div>
        </div>
    </div>
</body>